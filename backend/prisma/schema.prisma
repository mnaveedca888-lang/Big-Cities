generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String         @id @default(uuid())
  name            String
  email           String         @unique
  passwordHash    String?
  roleId          String?
  avatarUrl       String?
  isEmailVerified Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  activities      Activity[]
  notifications   Notification[]
  savedEvents     SavedEvent[]
  sessions        Session[]
  uploads         Upload[]
  role            Role?          @relation(fields: [roleId], references: [id])
}

model Role {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String?
  rolePermissions RolePermission[]
  users           User[]
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  roles       RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@unique([roleId, permissionId])
}

model Session {
  id               String   @id @default(uuid())
  userId           String
  refreshTokenHash String
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revoked          Boolean  @default(false)
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id])
}

model Event {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  description String?
  categoryId  String?
  countryCode String?
  citySlug    String?
  startAt     DateTime
  endAt       DateTime
  dateOnly     Boolean        @default(false)
  tags        String?
  featured    Boolean  @default(false)
  trending    Boolean  @default(false)
  enabled     Boolean  @default(true)
  image       String?
  venue       String?
  organizer   String?
  province    String?
  sourceName  String?
  sourceUrl   String?
  sourceType  String?
  primarySourceUrl String?
  primarySourceName String?
  primarySourceType String?
  discoverySourceUrl String?
  discoverySourceName String?
  verificationStatus String @default("UNVERIFIED")
  verificationScore Float?
  verificationReason String?
  verifiedAt  DateTime?
  lastCheckedAt DateTime?
  externalEventId String?
  lastSeenAt  DateTime?
  lastCollectedAt DateTime?
  contentHash String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sourceName, externalEventId])
  @@index([contentHash])
}

model EventDiscoveryState {
  id              String   @id @default(uuid())
  countryCode     String
  category        String
  lastAttemptedAt DateTime?
  lastSuccessfulAt DateTime?
  lastResultCount Int?
  nextQueryIndex  Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([countryCode, category])
  @@index([countryCode, lastAttemptedAt])
}

model EventDiscoveryRun {
  id                    String   @id @default(uuid())
  countryCode           String
  category              String
  query                 String
  budgetWindow          DateTime
  reserved              Boolean
  startedAt             DateTime @default(now())
  finishedAt            DateTime?
  youHttpStatus         Int?
  resultsFound          Int      @default(0)
  relevantEventPages    Int      @default(0)
  pagesFetched          Int      @default(0)
  pagesFailed           Int      @default(0)
  eventsDetected        Int      @default(0)
  datesExtracted        Int      @default(0)
  within48Hours         Int      @default(0)
  verificationPassed    Int      @default(0)
  saved                 Int      @default(0)
  inserted              Int      @default(0)
  updated               Int      @default(0)
  duplicates             Int      @default(0)
  rejectionCounts       Json?
  resultUrls            Json?
  candidateRejections  Json?
  error                 String?

  @@index([countryCode, startedAt])
  @@index([countryCode, category, startedAt])
}

model EventDiscoveryBudget {
  id          String   @id @default(uuid())
  countryCode String
  utcDate     DateTime
  searchCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([countryCode, utcDate])
}

model Category {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
}

model Country {
  code        String     @id
  name        String
  continentId String?
  profile     Json?
  continent   Continent? @relation(fields: [continentId], references: [id])
}

model Continent {
  id        String    @id @default(uuid())
  name      String    @unique
  countries Country[]
}

model City {
  slug           String  @id
  name           String
  countryCode    String
  profile        Json?
  isVerifiedCity Boolean @default(false)
}

model SavedEvent {
  id        String   @id @default(uuid())
  userId    String
  eventId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, eventId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Activity {
  id        String   @id @default(uuid())
  userId    String?
  label     String
  meta      String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

model Upload {
  id        String   @id @default(uuid())
  userId    String?
  fileKey   String
  url       String
  type      String?
  size      Int?
  attachedAt DateTime?
  expiresAt DateTime?
  deletedAt DateTime?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([attachedAt, expiresAt, deletedAt, createdAt])
}

model ImageCleanupJob {
  id            String    @id @default(uuid())
  fileKey       String    @unique
  status        String    @default("pending")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lastError     String?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([completedAt, nextAttemptAt, createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  meta      String?
  createdAt DateTime @default(now())
}
