DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public"
JWT_ACCESS_TOKEN_SECRET="your_access_secret_here"
JWT_REFRESH_TOKEN_SECRET="your_refresh_secret_here"

# Pakistan event ingestion is opt-in. Manual admin sync remains available when the server is running.
DATABASE_WRITES_ENABLED="false"
UPLOADS_ENABLED="false"
# Use S3-compatible object storage for durable uploads; production uploads are disabled unless configured.
UPLOAD_STORAGE_DRIVER="disabled"
# Supply these from the authorized storage provider's dashboard. Never commit real credentials.
# OBJECT_STORAGE_ENDPOINT=""
# OBJECT_STORAGE_REGION=""
# OBJECT_STORAGE_BUCKET=""
# OBJECT_STORAGE_ACCESS_KEY_ID=""
# OBJECT_STORAGE_SECRET_ACCESS_KEY=""
EVENT_DISCOVERY_ENABLED="false"
EVENT_SYNC_ENABLED="false"
EVENT_SYNC_INTERVAL_HOURS="24"
EVENT_DISCOVERY_INTERVAL_MINUTES="60"
EVENT_SYNC_RUN_ON_START="false"
EVENT_SYNC_EVENTBRITE_URL="https://www.eventbrite.com/d/pakistan--events/"
EVENT_SYNC_TIMEOUT_MS="15000"
# Automatic web discovery uses the free You.com MCP profile without a paid API key.
YDC_PROFILE="free"
EVENT_AI_DISCOVERY_COUNTRIES="PK"
# Application safety cap: maximum remote You.com searches per country per UTC day.
EVENT_DISCOVERY_DAILY_LIMIT="20"
# Optional controlled validation query; leave unset for the automatic country query.
# EVENT_DISCOVERY_QUERY=""

# Copy this file to .env and fill secrets for local development.# Database URL (SQLite for local development)
# Example Postgres DATABASE_URL for local development
# Replace USER, PASSWORD, HOST, PORT, and DATABASE accordingly
# e.g. postgres on localhost with default user/password
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public"

# Production example (Postgres with env vars)
# DATABASE_URL="postgresql://${DB_USER}:${DB_PASS}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public"

# Redis URL for caching and queues
# REDIS_URL=redis://localhost:6379

# S3 settings
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# JWT keys
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
