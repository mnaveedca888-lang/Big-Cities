{
  "name": "react-router-backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "node scripts/seed_locations.js",
    "seed:asia": "node scripts/seed_locations.js --continent Asia",
    "seed:south-america": "node scripts/seed_locations.js --continent \"South America\"",
    "seed:south-america-profiles": "node scripts/seed_south_america_profiles.js",
    "seed:south-america-events": "node scripts/seed_south_america_events.js",
    "seed:verified-daily-events": "node -r ts-node/register scripts/import_verified_daily_seed_events.ts",
    "verify:locations": "node scripts/verify_locations.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@fastify/cors": "^8.0.0",
    "@fastify/helmet": "^11.0.0",
    "@fastify/multipart": "^8.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^6.11.2",
    "@prisma/client": "^5.0.0",
    "argon2": "^0.45.1",
    "dotenv": "^17.4.2",
    "fastify": "^4.23.0",
    "i18n-iso-countries": "^7.14.0",
    "jsonwebtoken": "^9.0.3",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "prisma": "^5.0.0",
    "sharp": "^0.35.5",
    "ts-node-dev": "2.0.0",
    "typescript": "5.2.2"
  }
}
